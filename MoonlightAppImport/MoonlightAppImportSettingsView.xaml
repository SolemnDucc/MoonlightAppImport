<UserControl x:Class="MoonlightAppImport.MoonlightAppImportSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:my="clr-namespace:MoonlightAppImport"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ServerTypeValues" 
                    MethodName="GetValues" 
                    ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="my:ServerType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="RemoveTypeValues" 
            MethodName="GetValues" 
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="my:RemoveType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- Cache the theme styles first (prevents circular BasedOn references) -->
        <Style x:Key="ThemeTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}" />
        <Style x:Key="ThemeCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}" />
        <Style x:Key="ThemeSeparatorStyle" TargetType="{x:Type Separator}" BasedOn="{StaticResource {x:Type Separator}}" />
    </UserControl.Resources>
    <StackPanel Margin="10" VerticalAlignment="Top">
        <StackPanel.Resources>
            <!-- Implicit overrides: only set the properties to change -->
            <Style x:Key="SettingsTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource ThemeTextBoxStyle}">
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="400"/>
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ThemeCheckBoxStyle}">
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
            <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource ThemeSeparatorStyle}">
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </StackPanel.Resources>
        <!--Header-->
        <TextBlock Text="Moonlight App Import Settings" Margin="0,0,0,10" TextDecorations="Underline" TextOptions.TextFormattingMode="Display" FontSize="16"/>
        <!--Enable the Addon-->
        <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding Settings.IsEnabled}"/>
            <TextBlock Text="Import Games from Moonlight?"/>
        </StackPanel>
        <!--Moonlight Path-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <TextBlock Width="300" Text="Enter the path to the Moonlight.exe:"/>
            <TextBox Text="{Binding Settings.MoonlightPath}" Style="{StaticResource SettingsTextBoxStyle}"/>
        </StackPanel>
        <!--Host-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <TextBlock Width="300" TextWrapping="Wrap" Text="Enter the host address of the Sunshine server withouth http or port (e.g. 192.168.1.69 or localhost):"/>
            <TextBox Text="{Binding Settings.SunshineHost}" Style="{StaticResource SettingsTextBoxStyle}"/>
        </StackPanel>
        <!--Server type-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <TextBlock Width="300" Text="Select your server type:"/>
            <ComboBox SelectedItem="{Binding Settings.ServerType}" ItemsSource="{Binding Source={StaticResource ServerTypeValues}}" />
        </StackPanel>
        <!--Username (Sunshine)-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsSunshine}">
            <TextBlock Width="300" Text="Enter the username for the Sunshine server:"/>
            <TextBox Text="{Binding Settings.SunshineUsername}" Style="{StaticResource SettingsTextBoxStyle}"/>
        </StackPanel>
        <!-- Password (Sunshine) -->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsSunshine}">
            <TextBlock Width="300" TextWrapping="Wrap"
               Text="Enter the password for the Sunshine server (encrypted using your Windows Account):"/>

            <!-- Use a Grid to overlay the PasswordBox and the clear-text TextBox -->
            <Grid>
                <!-- The PasswordBox for masked input -->
                <PasswordBox Height="22" Width="400" HorizontalAlignment="Stretch"
                     my:PasswordBoxHelper.SecurePassword="{Binding Settings.SunshinePasswordSecure}">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hide the PasswordBox when the Show checkbox is checked -->
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChkShowSunshine}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <!-- The TextBox for clear-text input, synchronizing on every keystroke -->
                <TextBox Height="22" Width="400" HorizontalAlignment="Stretch"
                 Text="{Binding Settings.SunshinePassword, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Show the TextBox when the Show checkbox is checked -->
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChkShowSunshine}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <!-- The toggle button to switch between PasswordBox and TextBox -->
            <CheckBox x:Name="ChkShowSunshine" Content="Show" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Separator />

        <!-- API (Vibepollo) -->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsVibepollo}">
            <TextBlock Width="300" TextWrapping="Wrap"
               Text="Enter the API Key for the Vibepollo server (encrypted using your Windows Account):"/>

            <!-- Use a Grid to overlay the PasswordBox and the clear-text TextBox -->
            <Grid>
                <!-- The PasswordBox for masked input -->
                <PasswordBox Height="22" Width="400" HorizontalAlignment="Stretch"
                     my:PasswordBoxHelper.SecurePassword="{Binding Settings.VibepolloApiKeySecure}">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Hide the PasswordBox when the Show checkbox is checked -->
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChkShowVibepollo}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <!-- The TextBox for clear-text input, synchronizing on every keystroke -->
                <TextBox Height="22" Width="400" HorizontalAlignment="Stretch"
                 Text="{Binding Settings.VibepolloApiKey, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <!-- Show the TextBox when the Show checkbox is checked -->
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ChkShowVibepollo}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <!-- The toggle button to switch between PasswordBox and TextBox -->
            <CheckBox x:Name="ChkShowVibepollo" Content="Show" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Separator />
        <!--Skip Certificate-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <CheckBox IsChecked="{Binding Settings.SkipCertificateValidation}"/>
            <TextBlock Text="Skip certificate validation? You should check this if the Sunshine server does not have a valid certificate."/>
        </StackPanel>
        <!--Ping Server-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <CheckBox IsChecked="{Binding Settings.PingHost}"/>
            <TextBlock Text="Ping the Sunshine server before calling Api?"/>
        </StackPanel>
        <!--Add Dummy Meta Data-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <CheckBox IsChecked="{Binding Settings.AddMetadata}"/>
            <TextBlock Text="Add dummy Metadata to imported Games? Playnite will not automatically add the Metadata then!"/>
        </StackPanel>
        <!--Remove Games that are not in the Sunshine Server anymore?-->
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.IsEnabled}">
            <CheckBox IsChecked="{Binding Settings.RemoveGames}"/>
            <TextBlock Text="Should a game be removed from Playnite or marked as uninstalled if it no longer exists in the Sunshine server?"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding Settings.ShowRemoveTypePicker}">
            <TextBlock Width="100" Text="Remove mode:"/>
            <ComboBox SelectedItem="{Binding Settings.RemoveType}" ItemsSource="{Binding Source={StaticResource RemoveTypeValues}}" />
        </StackPanel>
    </StackPanel>
</UserControl>